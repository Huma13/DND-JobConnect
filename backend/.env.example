DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=jobconnect
POSTGRES_USER=jobconnect
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
# X API v2 app bearer token (developer.x.com). Without it the X source reports an error and other sources still run.
X_BEARER_TOKEN=
COLLECTOR_RESPECT_ROBOTS=1
COLLECTOR_MIN_DELAY_SECONDS=3
# Career-page auto-apply (issue #22): Greenhouse Job Board API key / Lever Postings API key.
GREENHOUSE_API_KEY=
LEVER_API_KEY=
# X direct messages (issue #30): OAuth 1.0a user-context credentials of the account that sends.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
